{
  "name": "@kristatech/mobile-wallet",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "HOST=127.0.0.1 NITRO_HOST=127.0.0.1 PORT=27811 NITRO_PORT=27811 nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate && node scripts/apply-csp.mjs",
    "preview": "HOST=127.0.0.1 NITRO_HOST=127.0.0.1 PORT=27811 NITRO_PORT=27811 nuxt preview",
    "typecheck": "nuxt typecheck",
    "assets": "python3 scripts/generate-mobile-assets.py",
    "cap:configure": "node scripts/configure-native.mjs",
    "cap:sync:android": "npx cap sync android",
    "cap:copy:ios": "npx cap copy ios",
    "cap:prepare": "npm run generate && npm run cap:configure && npm run cap:sync:android && npm run cap:copy:ios",
    "test": "node --experimental-strip-types --test tests/mobile-core.test.ts tests/mobile-audit.test.ts",
    "test:e2e": "node --experimental-strip-types --test tests/e2e.regtest.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/clipboard": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@kristatech/sdk": "file:../KristaTech-Wallet-SDK",
    "@tailwindcss/vite": "^4.1.0",
    "jsqr": "^1.4.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.8",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/ios": "^6.2.3",
    "@kristatech/electrum-server": "file:../KristaTech-Electrum-Server",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.8.0",
    "vue-tsc": "^2.2.0"
  },
  "license": "MIT"
}
